# Azure Neural Text-to-Speech (optional)
#
# 留空则自动回退到浏览器 SpeechSynthesis。
# 配置后启用 en-GB-RyanNeural 英式教授朗读（Dark Academia 风格）。
#
# 获取 key/region：https://portal.azure.com → 创建 "Speech" 资源
# region 用小写短名，如 eastus / westeurope / southeastasia

VITE_AZURE_SPEECH_KEY=
VITE_AZURE_SPEECH_REGION=eastus

# 可选：覆盖默认声音（默认 en-GB-RyanNeural）
# 备选：en-GB-ThomasNeural（更柔和）/ en-GB-SoniaNeural（女声）
# VITE_AZURE_SPEECH_VOICE=en-GB-RyanNeural

# 可选：Azure 表达风格（部分声音支持）
# 可选值：calm / gentle / sad / serious / fearful
# 注意 en-GB-RyanNeural 不支持 express-as，留空即可
# VITE_AZURE_SPEECH_STYLE=

# ─────────────────────────────────────────────────────────────
# LLM Runtime Config (Phase 9.6.5)
# ─────────────────────────────────────────────────────────────
#
# 留空（四个必填项任一缺失）则自动回退到本地 responseSimulator，
# Snape 仍可对话，只是响应由本地模板生成而非真实 LLM。
#
# Provider（平台）≠ Protocol（协议）：
#   - Provider 表示平台（openrouter / openai / agnes / deepseek / anthropic）
#     仅用于日志 / Analytics / UI 展示
#   - Protocol 表示协议（openai-compatible / anthropic）
#     决定走哪个 Client 实现（OpenAICompatibleClient / AnthropicClient）
#   - EnvRuntimeConfigProvider 内部维护 Provider → Protocol 映射表
#     用户只需配置 Provider，Protocol 自动推导，无需单独配置
#
# provider 取值：
#   openai      OpenAI 官方       → protocol: openai-compatible
#   openrouter  OpenRouter        → protocol: openai-compatible
#   deepseek    DeepSeek          → protocol: openai-compatible
#   agnes       Agnes             → protocol: openai-compatible
#   anthropic   Anthropic 原生    → protocol: anthropic
#
# 所有 OpenAI 兼容平台底层共用同一份 OpenAICompatibleClient，
# 只是 provider 标识不同（用于日志 / Analytics / UI 展示）。

VITE_LLM_PROVIDER=
VITE_LLM_API_KEY=
VITE_LLM_BASE_URL=
VITE_LLM_MODEL=

# 示例 1：OpenRouter（OpenAI 兼容协议）
# VITE_LLM_PROVIDER=openrouter
# VITE_LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
# VITE_LLM_BASE_URL=https://openrouter.ai/api/v1
# VITE_LLM_MODEL=google/gemma-3-27b-it:free

# 示例 2：Agnes（OpenAI 兼容协议）
# VITE_LLM_PROVIDER=agnes
# VITE_LLM_API_KEY=sk-agnes-xxxxxxxxxxxxxxxxxxxxxxxx
# VITE_LLM_BASE_URL=https://api.agnes.ai/v1
# VITE_LLM_MODEL=用户配置的模型名

# 示例 3：Anthropic（Anthropic 原生协议）
# VITE_LLM_PROVIDER=anthropic
# VITE_LLM_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# VITE_LLM_BASE_URL=https://api.anthropic.com/v1
# VITE_LLM_MODEL=用户配置的模型名

# ─────────────────────────────────────────────────────────────
# LLM 可选字段
# ─────────────────────────────────────────────────────────────

# 采样温度（0-2，默认由 Provider 决定）
# VITE_LLM_TEMPERATURE=0.8

# 最大 token 数
# VITE_LLM_MAX_TOKENS=1024

# 请求超时（毫秒，默认 60000）
# VITE_LLM_TIMEOUT=60000

# 自定义请求头（JSON 字符串，全部透传，不过滤不覆盖）
# OpenRouter 推荐配置 HTTP-Referer 与 X-Title：
# VITE_LLM_HEADERS_JSON={"HTTP-Referer":"https://example.com","X-Title":"The Half-Blood Prince's Study"}

# 重试配置（仅针对 429 / 500 / 502 / 503 / 504，两字段独立可选）
# VITE_LLM_RETRY_MAX_ATTEMPTS=2
# VITE_LLM_RETRY_DELAY=1000

